<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Library Book Management System</title>
</head>
	<body>
		<h1>Library Book Management System</h1>

		<label>Book Title:</label>
		<input type="text" id="txtBookTitle">
		<br><br>

		<label>Author Name:</label>
		<input type="text" id="txtAuthorName">
		<br><br>

		<label>Genre:</label>
		<input type="radio" name="genre" value="Fiction" id="rdoFiction" checked> Fiction
		<input type="radio" name="genre" value="Non-Fiction" id="rdoNonFiction"> Non-Fiction
		<br><br>

		<label>Number Of Copies:</label>
		<input type="number" id="numBookCopies">
		<br><br>

		<label>Year Published:</label>
		<input type="text" id="txtYearPublished">
		<br><br>

		<label>File Size:</label>
		<input type="number" id="numFileSize">
		<br><br>

		<label>Format:</label>
		<input type="radio" name="format" value="PDF" id="rdoPdf" checked> PDF
		<input type="radio" name="format" value="ePub" id="rdoEpub"> ePub
		<br><br>

		<button onclick="addBookBtn()">Add Book</button>
		<button onclick="updateBookBtn()()">Update Book</button>
		<button onclick="clearFieldsBtn()">Clear Fields</button>
		<br><hr>

		<h3>Book Records:</h3>
		<div id="divRecordOutput">No book record added yet.</div>

		<script src="script.js"></script>
	</body>
</html>
