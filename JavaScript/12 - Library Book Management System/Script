function displayBookRecords() {
	let display = "";

	display += "<br><hr>";
	display += "<span>Book ID </span> | ";
	display += "<span>Title </span> | ";
	display += "<span>Author </span> | ";
	display += "<span>Copies </span> | ";
	display += "<span>Published Year </span> | ";
	display += "<span>File Size </span> | ";
	display += "<span>Format </span> | ";
	display += "<span>Status </span> | ";

	for (let index = 0; index < bookArray.length; index++) {
		let book = bookArray[index];

		display += "<br><hr>";
		display += "<span>" + book.id + "</span> | ";
		display += "<span>" + book.title + "</span> | ";
		display += "<span>" + book.author + "</span> | ";
		display += "<span>" + book.copies + "</span> | ";
		display += "<span>" + book.publishedYear+ "</span> | ";
		display += "<span>" + (book.fileSize || "-") + "</span> | ";
		display += "<span>" + (book.format || "-") + "</span> | ";
		display += "<span>" + book.status + "</span> | ";
	}

	divRecordOutput.innerHTML = display;
}
