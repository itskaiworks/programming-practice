//Service type functions
function showServiceType () {

	document.getElementById("phoneMaintenance").style.display = "none";
	document.getElementById("hardwareRepair").style.display = "none";
	document.getElementById("softwareService").style.display = "none";

	if (serviceType.selectedIndex === 1) {

		document.getElementById("phoneMaintenance").style.display = "block";
	
	} else if (serviceType.selectedIndex === 2) {

		document.getElementById("hardwareRepair").style.display = "block";

	} else if (serviceType.selectedIndex === 3) {

		document.getElementById("softwareService").style.display = "block";

	}
}
