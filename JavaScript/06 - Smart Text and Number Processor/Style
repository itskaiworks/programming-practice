/* ===== Page Background ===== */
body {
    background-color: #fff0f6;
    font-family: Arial, sans-serif;
    color: #4a2c3a;
}

/* ===== Main Container ===== */
.container {
    width: 520px;
    margin: 40px auto;
    background-color: #ffffff;
    padding: 30px;
    border-radius: 14px;
    border: 2px solid #f8bbd0;
    box-shadow: 0 6px 15px rgba(255, 105, 180, 0.15);
}

/* ===== Title ===== */
h1 {
    text-align: center;
    color: #e91e63;
    margin-bottom: 25px;
}

/* ===== Sections ===== */
.section {
    background-color: #fff5f8;
    padding: 20px;
    border-radius: 12px;
    margin-bottom: 20px;
    border: 1px solid #f48fb1;
}

/* ===== Section Titles ===== */
.section h3 {
    color: #d81b60;
    margin-bottom: 15px;
}

/* ===== Labels ===== */
label {
    display: block;
    margin-bottom: 6px;
    font-size: 14px;
    color: #6a1b4d;
}

/* ===== Inputs & Select ===== */
input[type="text"],
select {
    width: 95%;
    padding: 9px;
    margin-bottom: 14px;
    border-radius: 8px;
    border: 1px solid #f48fb1;
    background-color: #fff;
}

input[type="text"]:focus,
select:focus {
    outline: none;
    border-color: #ec407a;
}

/* ===== Radio & Checkbox Groups ===== */
.radio-group label,
.checkbox-group label {
    display: inline-block;
    margin-right: 15px;
    font-size: 14px;
    color: #880e4f;
}

/* ===== Button ===== */
button {
    width: 100%;
    padding: 12px;
    background-color: #ec407a;
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 16px;
    cursor: pointer;
}

button:hover {
    background-color: #d81b60;
}

/* ===== Output Display ===== */
#pOutput {
    margin-top: 20px;
    padding: 15px;
    min-height: 60px;
    background-color: #fff0f6;
    border: 2px dashed #f48fb1;
    border-radius: 10px;
    color: #6a1b4d;
    font-size: 14px;
    line-height: 1.6;
}
