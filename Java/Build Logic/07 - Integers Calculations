import java.util.Scanner;

public class nIntegers {
	
	static int choice, size;
	static int [] array;
	static String inputNumber = "Enter a Number ", inputSize = "Enter a size: ";

	public static void main(String[] args) {
		
		Scanner sc = new Scanner(System.in);
		
		while (true) {

			System.out.println("Welcome! How can I help you? ");
			System.out.println("1. Sum \n2. Average \n3. Difference \n4. Exit");
			System.out.println(" ");
			System.out.print("Enter Choice:");
			choice = sc.nextInt();
			
			switch (choice) {
				case 1:
					System.out.print(inputSize);
					size = sc.nextInt();
					
					System.out.println(" ");
					
					array = new int [size];
					
					int sum = array[0];
					
					for (int index = 0; index < array.length; index++) {
						System.out.print(inputNumber + (index + 1) + ":");
						array[index] = sc.nextInt();
						sum += array[index];
					}
					
					System.out.println("Sum of all number/s: " + sum);
					break;
				case 2:
					System.out.print(inputSize);
					size = sc.nextInt();
					
					System.out.println(" ");
					
					array = new int [size];
					
					int aveSum = array [0];
					int ave = array [0];
					
					for (int index = 0; index < array.length; index++) {
						System.out.print(inputNumber + (index + 1) + ":");
						array[index] = sc.nextInt();
						aveSum += array[index];
					}
					
					System.out.println("Mean of all numbers: " + (aveSum / size));
					
					break;
				case 3:
					System.out.print(inputSize);
					size = sc.nextInt();
					
					System.out.println(" ");
					
					array = new int [size];
					
					for (int index = 0; index < array.length; index++) {
						System.out.print(inputNumber + (index + 1) + ":");
						array[index] = sc.nextInt();
					}
					
					int highest = array [0];
					int lowest = array [0];
					
					for (int index = 1; index < array.length; index++) {
						if (array[index] > highest) {
		                    highest = array[index];
		                }
		                if (array[index] < lowest) {
		                    lowest = array[index];
		                }
					}
					
					System.out.println("Difference of all numbers: " + (highest - lowest));
					break;
		}
			System.out.println(" ");
			
			if (choice == 4) {
				System.out.println("Program Terminated");
				break;
			}
		}
	} 
}
