                 "\n [3] Delete Enrollment Record" +
                 "\n [4] View All Enrollments" +
                 "\n [5] Generate Grade Report per Student" +
                 "\n [6] Back" +
                 "\n [0] Exit" +
                 "\n\n---------------------------------------");
           choice = getIntInput("\n Enter your choice: "); //Gets the user menu choice
           switch (choice) {
           case 1: //Enroll Student
               if (students.isEmpty()) {//Checks if the course list is empty
                   print("\n [!] Cannot enroll — student list is empty.\n");
                   break;
               }
              
               studentsToEnroll = getPositiveIntInput("\n Enter how many student to enroll: "); //Gets how many students the user wants to enroll
