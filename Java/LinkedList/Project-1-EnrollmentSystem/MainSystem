        	                    print("\n [!] Invalid input. Grade must be between 0 and 100.\n"); // Displays error for invalid input
        	                }
        	            }

        	            if (periodUpdate == 2 || periodUpdate == 3) { // If updating finals or both
        	                while (true) {
        	                    finals = getDoubleInput("\n Enter Finals Grade (0-100): "); // Requests finals grade
        	                    if (finals >= 0 && finals <= 100) break; // Accepts valid grade only
        	                    print("\n [!] Invalid input. Grade must be between 0 and 100.\n"); // Displays error for invalid input
        	                }
        	            }

        	            // ✅ Perform update after input
        	            int updated = enrollments.updateGrades(studentID, midterm, finals, periodCourse); // Calls method to update student grades
