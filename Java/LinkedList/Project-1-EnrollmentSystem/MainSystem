                       while (course == null) {
                           print("\n Enter course code " + count + ": ");
                           courseCode = read.readLine();
                           course = courses.findCourseByCode(courseCode);
                           if (course == null) {
                               print("\n [!] Please enter a course from the list.\n"); //Warning if the user input does not exist in the list of courses
                           }
                       }
                       result = enrollments.enrollStudent(student, course); //Will links the student and course to the enroll student method in the enrollment list
                      
                       if (result == 1) {
                       	print("\n Enrolling a student...");
                           print("\n [✓] Student " + student.getLastName() + ", " + student.getFirstName() +
                                 " successfully enrolled in " + course.getCourseCode() + ".\n"); //Confirmation that the student enrolled successfully
                       } else if (result == 0) {
                       	break;
                       }
                   }
               }
              
               break;
           case 2: // Update grades of students
        	    if (enrollments.isEmpty()) { // Checks if the course list is empty before proceeding
        	        print("\n [!] Cannot update — enrollment list is empty.\n"); // Prompts message if no students are enrolled
        	        break;
        	    }
        	    while (true) { // Loop for grade update menu
        	        print("\n Choose period to update: \n"); // Displays options for which period to update
        	        print(" [1] Midterm\n" +
        	              " [2] Finals\n" +
        	              " [3] Both Period\n" +
        	              " [4] Back\n");
        	        periodUpdate = getIntInput("\n Enter your choice: "); // Gets user's choice
        	        if (periodUpdate == 4) break; // Goes back to main menu if user selects "Back"
        	        if (periodUpdate < 1 || periodUpdate > 3) { // Validates input range
        	            print("\n [!] Invalid choice. Please enter a number between 1 and 4.\n"); // Error message for invalid input
        	            continue; // Repeats menu if invalid
        	        }

        	        studentID = getIntInput("\n Enter student ID: "); // Asks user for student ID
        	        int check = students.searchStudentByID(studentID); // Searches for the student in the list
        	        if (check == 0) break; // Exits if student is not found

        	        enrollments.whatCoursesStudentIsEnrolled(studentID); // Displays all courses that the student is enrolled in

        	        coursesGrade = getPositiveIntInput("\n Enter how many courses to update: "); // Asks how many courses to update grades for

        	        for (int count = 1; count <= coursesGrade; count++) { // Loops through each course to update
        	            print("\n Enter course code " + count + ": "); // Prompts for course code
        	            periodCourse = read.readLine().trim(); // Reads and trims the input for course code

        	            double midterm = -1; // Initializes midterm grade variable
        	            double finals = -1;  // Initializes finals grade variable

        	            // Ask for grades before calling update
        	            if (periodUpdate == 1 || periodUpdate == 3) { // If updating midterm or both
        	                while (true) {
        	                    midterm = getDoubleInput("\n Enter Midterm Grade (0-100): "); // Requests midterm grade
