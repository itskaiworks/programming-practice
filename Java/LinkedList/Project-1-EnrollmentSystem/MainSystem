           case 4: // View all enrollment records
        	    if (enrollments.isEmpty()) { // Checks if there are any records in the enrollment list
        	        print("\n [!] No enrollment records to display.\n"); // Displays a warning if the list is empty
        	        break; // Exits this case if no records exist
        	    }
        	    enrollments.viewAllEnrollments(); // Calls method to display all existing enrollment records
        	    break; // Ends case 4

        	case 5: // Generate report for a specific student
        	    if (enrollments.isEmpty()) { // Checks if there are any enrollment records
        	        print("\n [!] Cannot generate report — no enrollment records found.\n"); // Displays a message if none exist
        	        break; // Exits this case
        	    }
        	    generateReport = getIntInput("\n Enter student ID: "); // Prompts user to input a student ID for report generation
        	    enrollments.generateStudentReport(generateReport); // Calls method to generate and display the student’s report
        	    break; // Ends case 5

        	case 6: // Return to main menu
        	    displayMainMenu(); // Calls method to display the main menu
        	    break; // Ends case 6

        	case 0: // Exit the program
        	    print("\n Terminating system..."); // Displays system termination message
        	    System.exit(0); // Closes the entire program
        	    break; // (Unreachable after System.exit, but kept for consistency)

        	default: // Handles invalid menu choices
        	    print("\n [!] Invalid choice. Please enter a number between 0 and 6.\n"); // Displays error for out-of-range inputs
        	    break; // Returns to menu for a valid input

           }
       }
   }
   public static void displayReportsAndSummaryMenu() throws IOException {
	    while (true) { // Loop to continuously display the Reports & Summary menu until the user exits or goes back
	        print("\n=======================================");
	        print("\n     UNIVERSITY ENROLLMENT SYSTEM      ");
	        print("\n        > Reports & Summary <          ");
	        print("\n=======================================\n");

	        students.totalStudents(); // Displays the total number of registered students
	        courses.totalCourses(); // Displays the total number of available courses
	        enrollments.listFailedStudents(); // Lists all students who failed any course
	        enrollments.averageGradePerStudent(enrollments); // Displays the average grade of each student

	        // Menu options for user navigation
	        print("\n---------------------------------------" +
	              "\n [1] Back" + // Option to return to the previous menu
	              "\n [0] Exit" + // Option to terminate the system
	              "\n---------------------------------------");

	        int choiceReport = getIntInput("\n Enter your choice: "); // Prompts user for a menu selection

	        switch (choiceReport) { // Handles user’s input choice
	            case 1: // If user chooses "Back"
	                return; // Returns to the previous menu (exits this method)
	            case 0: // If user chooses "Exit"
	                print("\n Terminating system..."); // Displays system termination message
	                System.exit(0); // Ends the entire program
	                break;
	            default: // Handles invalid menu inputs
	                print("\n Invalid choice. Please enter 0 or 1.\n"); // Displays warning for invalid input
	                break;
	        }
	    }
	}
   public static int getIntInput(String message) throws IOException {
	    // This method gets an integer input from the user with validation.
	    while (true) { // Loop until a valid integer is entered
	        print(message); // Displays the input prompt message
	        try {
	            return Integer.parseInt(read.readLine()); // Reads input and converts it to an integer
	        } catch (NumberFormatException e) { // Catches invalid inputs (e.g., letters or symbols)
	            print("\n [!] Invalid input! Please enter valid number.\n"); // Displays error message
	        }
	    }
	}

	public static double getDoubleInput(String message) throws IOException {
	    // This method gets a double (decimal) input from the user with validation.
	    while (true) { // Loop until a valid double is entered
	        print(message); // Displays the input prompt message
	        try {
	            return Double.parseDouble(read.readLine()); // Reads input and converts it to a double
	        } catch (NumberFormatException e) { // Catches invalid inputs (e.g., text instead of numbers)
	            print("\n [!] Invalid input! Please enter valid number.\n"); // Displays error message
	        }
	    }
	}

	public static int getPositiveIntInput(String message) throws IOException {
	    // This method gets a positive integer input from the user.
	    int value;
	    do {
	        value = getIntInput(message); // Calls getIntInput() to read user input
	        if (value < 0) { // Checks if the input number is negative
	            print("\n [!] Invalid input! Please enter valid number.\n"); // Displays error for negative values
	        }
	    } while (value < 0); // Repeats until a non-negative number is entered
	    return value; // Returns the valid positive integer
	}

	public static void print(String word) {
	    // Simple helper method to print messages to the console without adding a new line.
	    System.out.print(word);
	}
