                       checkExist = courses.searchCourseByCode(courseCode);
                       if(checkExist == 1) { //Checks if the course code is already added
                       	print("\n [✓] Course code " + courseCode + " is already added.\n");
                       	break;
                       }
                       print(" Enter course title: ");
                       courseTitle = read.readLine();
                       units = getPositiveIntInput(" Enter units: ");
                       slot = getPositiveIntInput(" Enter number of slots: ");
