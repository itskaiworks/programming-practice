                       print("\n [!] Cannot enroll — course list is empty.\n");
                       break;
                   } else {
                       courses.viewAllCourses(); //Will display the course list so the user can choose
                   }
                   numCourse = getPositiveIntInput("\n Enter how many courses to enroll: "); //Will get how many course the user want's to enroll for student
