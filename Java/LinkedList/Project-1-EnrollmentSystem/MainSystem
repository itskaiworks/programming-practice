                   break;
               case 2: //View all course
                   if (courses.isEmpty()) {//Checks if the course list is empty
                       print("\n [!] No courses available to display.\n");
                       break;
                   }
                   courses.viewAllCourses(); //This method from course list will display the list of courses
                   break;
               case 3: //Update course
                   if (courses.isEmpty()) {//Checks if the course list is empty
                       print("\n [!] Cannot update — course list is empty.\n");
                       break;
                   }
                   print("\n Enter course code to update: ");
                   String originalCourseCode = read.readLine();
                   checkExist = courses.searchCourseByCode(originalCourseCode); //This checks if the course code already exist in the course list
                   if (checkExist == 0) {
                   	print("\n [!] No course " + courseCode + " found in the list.\n"); //Will be the warning once the course list is empty
                   	break;
                   }
                  
                   print("\n\n Choose what to update: \n");
                   print(" [1] Course Code\n" +
                         " [2] Course Title\n" +
                         " [3] Units\n" +
                         " [4] Slots\n" +
                         " [5] Full Information\n" +
                         " [6] Back\n");
                   while (true) { //This will keep looping until the user input is valid
                       choiceUpdate = getIntInput("\n Enter your choice: ");
                       if (choiceUpdate == 6) break;
                       if (choiceUpdate == 1 || choiceUpdate == 2) { //If the user want's to update is the course code or course title
                           print("\n Enter new information: ");
                           newInfo = read.readLine();
                       }
                       if (choiceUpdate == 3 || choiceUpdate == 4) { //If the user want's to update is the course units and slots
                           newValue = getPositiveIntInput("\n Enter new value: ");
                       }
                       if (choiceUpdate == 5) { //If the user want's to update the overall information of the specific course
                           print("\n Enter course code: ");
                           courseCode = read.readLine();
                           print(" Enter course title: ");
                           courseTitle = read.readLine();
                           units = getPositiveIntInput(" Enter units: ");
                           slot = getPositiveIntInput(" Enter number of slots: ");
                       }
                       // Call update inside the loop so each choice updates immediately
                       int result = courses.updateCourse(originalCourseCode, choiceUpdate, newInfo, newValue, courseCode,
                       		                          courseTitle, units, slot); //This will links the user input to update in the update methods in course list
                       if (result == 0) {
                           print("\n [!] Invalid choice. Please enter a number between 1 and 6.\n"); //Warning once the user input is invalid
                       } else if (result == 1) { 
                           break;
                       }
                   }
                   break;
               case 4: //Delete course
                   if (courses.isEmpty()) { //Checks if the course list is empty
                       print("\n [!] Cannot delete — course list is empty.\n");
                       break;
                   }
                   print("\n Enter a course code to delete: ");
                   courseCode = read.readLine();
                   courses.deleteCourse(courseCode); //This will links the data that the user wants to delete in delete course method in the course list
                   break;
               case 5: //Search course
                   if (courses.isEmpty()) {//Checks if the course list is empty
                       print("\n [!] Cannot search — course list is empty.\n");
                       break;
                   }
                   print("\n Enter course code: ");
                   courseCode = read.readLine();
                   checkExist = courses.searchCourseByCode(courseCode); //This will links the user input to search for specific course in the course list
                   if(checkExist == 0 ) {
                   	print("\n [!] No course " + courseCode + " found in the list.\n"); //Warning if the course list is empty
                   	break;
                   }
                   break;
               case 6: //Back to the main menu
                   displayMainMenu();
                   break;
               case 0: //Terminate program
                   print("\n Terminating system...");
                   System.exit(0);
                   break;
               default: //Error handling
                   print("\n Invalid choice. Please enter a number between 0 and 6.\n"); //Warning if the user input is invalid
                   break;
           }
       }
   }
   public static void displayEnrollmentAndGradesMenu() throws IOException {
       String courseCode, deleteCourse, periodCourse;
