public class OverallNode {
  private Student student;
  private Course course;
  private Enrollment enrollment;
  private OverallNode next;
  private OverallNode prev;
  // Access Student Data
  public Student getStudent() {
      return student;
  }
  public void setStudent(Student student) {
      this.student = student;
  }
  // Access Course Data
  public Course getCourse() {
      return course;
  }
  public void setCourse(Course course) {
      this.course = course;
  }
  // Access Enrollment Data
  public Enrollment getEnrollment() {
      return enrollment;
  }
  public void setEnrollment(Enrollment enrollment) {
      this.enrollment = enrollment;
  }
  // Linked List Connections
  public OverallNode getNext() {
      return next;
  }
  public void setNext(OverallNode next) {
      this.next = next;
  }
  public OverallNode getPrev() {
      return prev;
  }
  public void setPrev(OverallNode prev) {
      this.prev = prev;
  }
}
