    public boolean isSameString(String checkString1, String checkString2) {
        if (checkString1 == null || checkString2 == null) return false;

        int stringLength1 = 0;
        int stringLength2 = 0;

        try {
            while (true) {
                checkString1.charAt(stringLength1);
                stringLength1++;
            }
        } catch (StringIndexOutOfBoundsException e) {}

        try {
            while (true) {
                checkString2.charAt(stringLength2);
                stringLength2++;
            }
        } catch (StringIndexOutOfBoundsException e) {}

        if (stringLength1 != stringLength2) return false;

        for (int index = 0; index < stringLength1; index++) {
            char character1 = checkString1.charAt(index);
            char character2 = checkString2.charAt(index);

            if (character1 >= 'a' && character1 <= 'z') character1 -= 32;
            if (character2 >= 'a' && character2 <= 'z') character2 -= 32;

            if (character1 != character2) return false;
        }
        return true;
    }

    public boolean isEmpty() {
        return head == null;
    }

