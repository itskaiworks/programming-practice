    public void listFailedStudents() {
        if (isEmpty()) {
            print("\n [!] No enrollment records to check for failed students.\n");
            return;
        }

        OverallNode outer = head;
        boolean anyFailed = false;
        print("\n=======================================");
        print("\n       LIST OF FAILED STUDENTS         ");
        print("\n       > At least One Subject <        ");
        print("\n=======================================");

        while (outer != null) {
            Enrollment enrollment1 = outer.getEnrollment();
            if (enrollment1 != null) {
                Student student1 = enrollment1.getStudent();
                int currentID = student1.getStudentID();
                boolean alreadyShown = false;

                OverallNode check = head;
                while (check != outer) {
                    Enrollment prev = check.getEnrollment();
                    if (prev != null && prev.getStudent().getStudentID() == currentID) {
                        alreadyShown = true;
                        break;
                    }
                    check = check.getNext();
                }

                if (!alreadyShown) {
                    boolean failedOnce = false;
                    OverallNode search = head;
                    while (search != null) {
                        Enrollment enrollmentSearch = search.getEnrollment();
                        if (enrollmentSearch != null &&
                            enrollmentSearch.getStudent().getStudentID() == currentID &&
                            isSameString("FAILED", enrollmentSearch.getRemarks())) {
                            failedOnce = true;
                            break;
                        }
                        search = search.getNext();
                    }

                    if (failedOnce) {
                        anyFailed = true;
                        print("\n_______________________________________");
                        print("\n\n STUDENT NO. " + student1.getStudentID() + " | " +
                              student1.getLastName() + ", " + student1.getFirstName());
                        print("\n_______________________________________\n");

                        OverallNode inner = head;
                        while (inner != null) {
                            Enrollment enrollment2 = inner.getEnrollment();
                            if (enrollment2 != null &&
                                enrollment2.getStudent().getStudentID() == currentID &&
                                isSameString("FAILED", enrollment2.getRemarks())) {
                                Course course = enrollment2.getCourse();
                                print("\n  " + course.getCourseCode() + "     : " + course.getCourseTitle());
                                print("\n  Average : " + enrollment2.getAverage());
                                print("\n---------------------------------------");
                            }
                            inner = inner.getNext();
                        }
                    }
                }
            }
            outer = outer.getNext();
        }

        if (!anyFailed) {
            print("\n\n [!] No students failed in any subject.\n");
        }
    }

    public void averageGradePerStudent(EnrollmentList enrollments) {
        if (isEmpty()) {
            print("\n [!] No enrollments available to calculate averages.\n");
            return;
        }

        OverallNode outer = enrollments.head;
        print("\n\n=======================================");
        print("\n      AVERAGE GRADE PER STUDENT         ");
        print("\n      > Course & Overall Mean <         ");
        print("\n======================================= ");

        while (outer != null) {
            Enrollment enrollment1 = outer.getEnrollment();
            if (enrollment1 != null) {
                Student student1 = enrollment1.getStudent();
                int currentID = student1.getStudentID();
                boolean alreadyShown = false;

                OverallNode check = enrollments.head;
                while (check != outer) {
                    Enrollment prev = check.getEnrollment();
                    if (prev != null && prev.getStudent().getStudentID() == currentID) {
                        alreadyShown = true;
                        break;
                    }
                    check = check.getNext();
                }

                if (!alreadyShown) {
                    print("\n_______________________________________");
                    print("\n\n STUDENT NO. " + student1.getStudentID() + " | " +
                          student1.getLastName() + ", " + student1.getFirstName());
                    print("\n_______________________________________\n");

                    double totalAverage = 0;
                    int totalCourses = 0;

                    OverallNode inner = enrollments.head;
                    while (inner != null) {
                        Enrollment enrollment2 = inner.getEnrollment();
                        if (enrollment2 != null &&
                            enrollment2.getStudent().getStudentID() == currentID) {
                            enrollment2.computeAverageGrades();
                            Course course = enrollment2.getCourse();
                            print("\n  " + course.getCourseCode() + "     : " + course.getCourseTitle());
                            print("\n  Average : " + enrollment2.getAverage());
                            print("\n---------------------------------------");
                            totalAverage += enrollment2.getAverage();
                            totalCourses++;
                        }
                        inner = inner.getNext();
                    }

                    if (totalCourses > 0) {
                        double overallAverage = totalAverage / totalCourses;
                        print("\n Overall Average : " + overallAverage);
                        print("\n=======================================");
                    }
                }
            }
            outer = outer.getNext();
        }
    }

