public class EnrollmentList {
    private OverallNode head;
    private OverallNode tail;

    // Method for enrolling students
    public int enrollStudent(Student student, Course course) {
        if (course.getSlots() <= 0) { // if the course slots is 0 it prompts a message
            print("\n [!] Cannot enroll. " + course.getCourseCode() + " is already full.");
            return -1; // Return -1 to indicate enrollment failed
        }

        OverallNode current = head;
        while (current != null) { // traverse the list                                               
            Enrollment enroll = current.getEnrollment();
            if (enroll != null &&
                enroll.getStudent().getStudentID() == student.getStudentID() &&
                isSameString(enroll.getCourse().getCourseCode(), course.getCourseCode())) { // If the student is already enrolled in a specific course
                print("\n [!] Student is already enrolled in this course.\n");
                return 0; // Return 0 to indicate duplicate enrollment
            }
            current = current.getNext(); // Move to the next node
        }

        Enrollment newEnrollment = new Enrollment(student, course); // Create new enrollment object
        student.setStatus("ACTIVE"); // Update student's status
        course.setSlots(course.getSlots() - 1); // Reduce course slots

        OverallNode newNode = new OverallNode();
        newNode.setEnrollment(newEnrollment);
        newNode.setStudent(student);
        newNode.setCourse(course);

        if (head == null) { // No enrollment yet
            head = newNode;
            tail = newNode;
        } else {
            tail.setNext(newNode);
            newNode.setPrev(tail);
            tail = newNode;
        }
        return 1; // Return 1 to indicate successful enrollment
    }

    // Method to update the grades (midterm and final) of a student in a specific course
    public int updateGrades(int studentID, double newMidterm, double newFinal, String courseCode) {
        OverallNode current = head;
        while (current != null) {
            Enrollment enrolled = current.getEnrollment();

            if (enrolled != null && enrolled.getStudent().getStudentID() == studentID) {
                if (isSameString(enrolled.getCourse().getCourseCode(), courseCode)) {
                    double updatedMidterm = (newMidterm >= 0) ? newMidterm : enrolled.getMidtermGrade();
                    double updatedFinal = (newFinal >= 0) ? newFinal : enrolled.getFinalGrade();

                    enrolled.setMidtermGrade(updatedMidterm);
                    enrolled.setFinalGrade(updatedFinal);

                    enrolled.computeAverageGrades();
                    enrolled.generateRemarkBasedOnAverage();
                    return 1;
                }
            }
            current = current.getNext();
        }
        return 0;
    }

    public boolean deleteEnrollment(int studentID, String course) {
        OverallNode current = head;
        while (current != null) {
            Enrollment enrollment = current.getEnrollment();

            if (enrollment != null &&
                enrollment.getStudent().getStudentID() == studentID &&
                isSameString(enrollment.getCourse().getCourseCode(), course)) {

                if (current == head) {
                    head = current.getNext();
                    if (head != null) head.setPrev(null);
                    else tail = null;

                } else if (current == tail) {
                    tail = current.getPrev();
                    if (tail != null) tail.setNext(null);

                } else {
                    current.getPrev().setNext(current.getNext());
                    current.getNext().setPrev(current.getPrev());
                }

                print("\n Deleting enrollment record...");
                return true;
            }
            current = current.getNext();
        }
        return false;
    }

    public void generateStudentReport(int studentID) {
        int totalEnrollments = 0, passedCount = 0, failedCount = 0;
        double totalAverage = 0;
        boolean studentFound = false;
        OverallNode current = head;
        Student student = null;

        while (current != null) {
            Enrollment enrollment = current.getEnrollment();
            if (enrollment != null && enrollment.getStudent().getStudentID() == studentID) {
                studentFound = true;
                student = enrollment.getStudent();
                break;
            }
            current = current.getNext();
        }

        if (!studentFound) {
            print("\n [!] No enrollment records found for student ID " + studentID + "\n");
            return;
        }

        print("\n Generating student record for student number " + studentID + "...");
        print("\n======================================= ");
        print("\n             STUDENT REPORT             ");
        print("\n======================================= ");
        print("\n Student ID   : S-" + student.getStudentID());
        print("\n Student Name : " + student.getLastName() + ", " + student.getFirstName());
        print("\n Year Level   : " + student.getYearLevel());
        print("\n Program      : " + student.getProgram());
        print("\n======================================= ");
        print("\n           ENROLLED COURSES             ");
        print("\n======================================= ");

        current = head;
        while (current != null) {
            Enrollment enrollment = current.getEnrollment();
            if (enrollment != null && enrollment.getStudent().getStudentID() == studentID) {
                Course course = enrollment.getCourse();
                print("\n Course Code   : " + course.getCourseCode());
                print("\n Course Title  : " + course.getCourseTitle());
                print("\n Midterm Grade : " + enrollment.getMidtermGrade());
                print("\n Final Grade   : " + enrollment.getFinalGrade());
                print("\n Average       : " + enrollment.getAverage());
                print("\n Equivalent    : " + enrollment.getEquivalent());
                print("\n Remarks       : " + enrollment.getRemarks());
                print("\n---------------------------------------");

                totalEnrollments++;
                totalAverage += enrollment.getAverage();

                if (isSameString("PASSED", enrollment.getRemarks())) passedCount++;
                else if (isSameString("FAILED", enrollment.getRemarks())) failedCount++;
            }
            current = current.getNext();
        }

        if (totalEnrollments == 0) {
            print("\n\n [!] No enrollments found for entered student ID.\n");
        } else {
            print("\n======================================= ");
            print("\n                SUMMARY                 ");
            print("\n======================================= ");
            print("\n Total Enrollments : " + totalEnrollments);
            print("\n Passed Courses    : " + passedCount);
            print("\n Failed Courses    : " + failedCount);
            print("\n Overall Average   : " + (totalAverage / totalEnrollments));
            print("\n======================================= \n");
        }
    }

