package passwordToggle;

import java.awt.Font;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

import javax.swing.JButton;
import javax.swing.JFrame;
import javax.swing.JLabel;
import javax.swing.JPanel;
import javax.swing.JPasswordField;
import javax.swing.border.EmptyBorder;

public class PasswordToggle {

	public static void main(String[] args) {
		JFrame frame = new JFrame("Show/Hide Password Example");
		JPanel panel = new JPanel();
		JPasswordField passwordField = new JPasswordField();
		JButton showBtn = new JButton("Show");
		JLabel label = new JLabel("Enter Password:");
		
		frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
		frame.setBounds(100, 100, 400, 200);
		frame.setResizable(false);
		frame.setLocationRelativeTo(null);
		frame.setVisible(true);
		
		frame.add(panel);
		panel.setBorder(new EmptyBorder(5, 5, 5, 5));
		panel.setLayout(null);
		
		panel.add(label);
		label.setFont(new Font("Tahoma", Font.PLAIN, 16));
		label.setBounds(30, 40, 150, 30);
		
		panel.add(passwordField);
		passwordField.setBounds(160, 40, 150, 30);
		
		panel.add(showBtn);
		showBtn.setBounds(320, 40, 70, 30);
		
		showBtn.addActionListener(new ActionListener() {
			private boolean isPasswordVisible = false;

			public void actionPerformed(ActionEvent e) {
				if (isPasswordVisible) {
					passwordField.setEchoChar('•'); // Hide password
					showBtn.setText("Show");
				} else {
					passwordField.setEchoChar((char) 0); // Show password
					showBtn.setText("Hide");
				}
				isPasswordVisible = !isPasswordVisible;
			}
		});
	}
}
    
