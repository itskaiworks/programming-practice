						if (arts.isSelected()) {
							selectedHobbies += arts.getText() + " ";
						} 
						if (academic.isSelected()) {
							selectedHobbies += academic.getText() + " ";
						} 
						if (others.isSelected()) {
							selectedHobbies += others.getText() + " ";
						}
								
						//Validation if the input fields are empty
	                    if (firstNameInput.isEmpty() || middleNameInput.isEmpty() || lastNameInput.isEmpty() || programChoice.isEmpty() || ageInput.isEmpty() 
	                    	|| addressInput.isEmpty() || signUser.isEmpty() || signPass.isEmpty()) {
							
							throw new Exception("All fields must be filled!");
				        
						//To ensure that exactly one gender option is selected
						} else if ( !male.isSelected() && !female.isSelected() && !pnts.isSelected()) {
							
							throw new Exception("Please select one option for sex!");
							
						//To ensure that exactly one hobby option is selected
						} else if (!sports.isSelected() && !arts.isSelected() && !academic.isSelected() && !others.isSelected()) {
							
