				public void actionPerformed(ActionEvent e) {
					
					try {
						 //Retrieve input from text fields
						firstNameInput = firstTf.getText().trim();
						middleNameInput = middleTf.getText().trim();
						lastNameInput = lastTf.getText().trim();
						programChoice = programTf.getText().trim();
						ageInput = ageTf.getText().trim();
						addressInput = textArea.getText().trim();
						signUser = userTf.getText().trim();
						signPass = new String(passTf.getPassword()).trim();
						
						//Determine selected gender option
						
						if (male.isSelected()) { 
							sexChoice = male.getText();
						} else if (female.isSelected()) {
							sexChoice = female.getText();
						} else if (pnts.isSelected()) {
							sexChoice = pnts.getText();
						}
						
						//Determine selected hobbies option
						
